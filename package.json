    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.29.0",
    "npm-run-all2": "^6.2.3",
    "nuxt": "^3.13.2",
    "prettier": "^3.3.3",
    "sass": "^1.80.1",
    "sass-loader": "^16.0.2",
    "typescript": "~5.3.3",
    "vite": "^5.4.9",
    "vite-plugin-dts": "^4.2.4",
    "vite-plugin-package-version": "^1.1.0",
    "vitepress": "1.0.0-rc.45",
    "vue-tsc": "^1.8.27"
