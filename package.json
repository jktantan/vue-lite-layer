{
  "name": "vue-lite-layer",
  "version": "1.2.0",
  "description": "A lightweight, flexible Vue 3 modal / layer component library with a service-style API: drag, maximize & restore, multi-layer z-index management, focus trap, i18n and Nuxt module support.",
  "private": false,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "files": [
    "lib",
    "dist",
    "dist/**",
    "!dist/lib",
    "!dist/lib/**",
    "!dist/runtime",
    "!dist/runtime/**",
    "!dist/nuxt/lib",
    "!dist/nuxt/lib/**",
    "!dist/favicon.svg"
  ],
  "main": "./dist/vue-lite-layer.umd.js",
  "module": "./dist/vue-lite-layer.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vue-lite-layer.umd.js",
  "jsdelivr": "./dist/vue-lite-layer.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-lite-layer.es.js",
      "default": "./dist/vue-lite-layer.es.js"
    },
    "./style.css": "./dist/vue-lite-layer.css",
    "./theme.css": "./dist/theme.css",
    "./theme": "./lib/assets/style/theme.scss",
    "./theme.scss": "./lib/assets/style/theme.scss",
    "./scss": "./lib/assets/style/index.scss",
    "./scss/*": "./lib/assets/style/*",
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.mjs",
      "default": "./dist/nuxt/module.mjs"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "nuxt": {
    "module": "./dist/nuxt/module.mjs"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jktantan/vue-lite-layer.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "nuxt",
    "nuxt-module",
    "layer",
    "modal",
    "dialog",
    "popup",
    "overlay",
    "window",
    "draggable",
    "component",
    "composable",
    "typescript",
    "ui"
  ],
  "author": {
    "name": "tantan",
    "url": "https://github.com/jktantan"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jktantan/vue-lite-layer/issues"
  },
  "homepage": "https://jktantan.github.io/vue-lite-layer",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint --fix",
    "format": "prettier --write \"lib/**/*.{ts,vue,scss}\" \"docs/**/*.{ts,vue,css}\" \"src/**/*.{ts,vue}\"",
    "lib:build": "run-s lib:type-check lib:build:main lib:build:nuxt lib:build:theme lib:clean lib:build:verify",
    "lib:type-check": "vue-tsc --noEmit --pretty false --project tsconfig.lib.json",
    "lib:build:theme": "sass --no-source-map --style=compressed --load-path=. lib/assets/style/theme.scss dist/theme.css",
    "test:unit": "vitest run",
    "test:types": "vue-tsc --noEmit --pretty false --project tsconfig.test.json",
    "test:dist": "node tests/dist-checks/html-warning.test.mjs",
    "test:dist-types": "vue-tsc --noEmit --pretty false --project tsconfig.dist-test.json",
    "test": "run-s test:unit test:types",
    "test:lib": "bash scripts/test-lib.sh",
    "test:lib:win": "powershell -ExecutionPolicy Bypass -File scripts/test-lib.ps1",
    "lib:build:main": "vite --config vite.config.lib.ts build",
    "lib:build:nuxt": "vite --config vite.config.lib.ts build --mode nuxt",
    "lib:clean": "node scripts/clean-dist.mjs",
    "lib:build:verify": "pnpm test:dist"
  },
  "dependencies": {
    "defu": "^6.1.7",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.16",
    "vue-i18n-lite": "^1.0.2"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mdit/plugin-tasklist": "^1.1.1",
    "@nuxt/kit": "^4.5.2",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^25.9.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/runtime-core": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "element-plus": "^2.14.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.3",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-package-version": "^1.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11",
    "vxe-table": "^4.21.10"
  }
}
