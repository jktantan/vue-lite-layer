    "mitt": "^3.0.1",
    "nanoid": "^5.0.7",
    "vue": "^3.5.12",
    "vue-i18n-lite": "^1.0.2",
    "vxe-table": "^4.6.21"
  },
  "devDependencies": {
    "@mdit/plugin-tasklist": "^0.8.0",
