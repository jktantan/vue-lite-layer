{
  "name": "vue-lite-layer",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "files": [
    "lib",
    "dist"
  ],
  "main": "dist/vue-lite-layer.umd.js",
  "module": "dist/vue-lite-layer.es.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-lite-layer.es.js",
      "require": "./dist/vue-lite-layer.umd.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.mjs"
    },
    "./dist/*": "./dist/*"
  },
  "nuxt": {
    "module": "./dist/nuxt/module.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jktantan/vue-lite-layer.git"
  },
  "keywords": [
    "vue",
    "nuxt",
    "layer",
    "global"
  ],
  "author": "tantan",
  "license": "Apache",
  "bugs": {
    "url": "https://github.com/jktantan/vue-lite-layer/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/jktantan/vue-lite-layer.git",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint --fix",
    "format": "prettier --write \"lib/**/*.{ts,vue,scss}\" \"docs/**/*.{ts,vue,css}\" \"src/**/*.{ts,vue}\"",
    "lib:build": "run-s lib:build:main lib:build:nuxt lib:build:verify",
    "test:unit": "vitest run",
    "test:types": "vue-tsc --noEmit --pretty false --project tsconfig.test.json",
    "test:dist": "node tests/dist-checks/html-warning.test.mjs",
    "test:dist-types": "vue-tsc --noEmit --pretty false --project tsconfig.dist-test.json",
    "test": "run-p test:unit test:types",
    "test:lib": "bash scripts/test-lib.sh",
    "test:lib:win": "powershell -ExecutionPolicy Bypass -File scripts/test-lib.ps1",
    "lib:build:main": "vite --config vite.config.lib.ts build",
    "lib:build:nuxt": "vite --config vite.config.lib.ts build --mode nuxt",
    "lib:build:verify": "pnpm test:dist"
  },
  "dependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "defu": "^6.1.7",
    "js-base64": "^3.9.1",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.16",
    "vue-i18n-lite": "^1.0.2"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mdit/plugin-tasklist": "^1.0.1",
    "@nuxt/kit": "^4.5.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^25.9.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/runtime-core": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "nuxt": "^4.5.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.100.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-package-version": "^1.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8",
    "vxe-table": "^4.20.7"
  }
}
